{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.byteask/embedded-docs",
  "description": "Page-cited retrieval for embedded docs, datasheets, MISRA, CMSIS, and RTOS references. OAuth 2.1 via LIME (M2M agents).",
  "version": "1.0.1",
  "websiteUrl": "https://docs.byteask.ai/embedded",
  "repository": {
    "url": "https://github.com/ByteAsk/ByteAsk-Embedded-MCP",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.byteask.ai/mcp",
      "oauth": {
        "authorization_server": "https://lime.pics",
        "protected_resource_metadata": "https://mcp.byteask.ai/.well-known/oauth-protected-resource"
      }
    }
  ]
}
